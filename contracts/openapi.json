      "ShopMatch": {
        "additionalProperties": false,
        "properties": {
          "distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Km"
          },
          "evidence": {
            "const": "shop_record_only",
            "default": "shop_record_only",
