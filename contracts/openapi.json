          },
          "shop_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Shop Id",
            "type": "string"
          },
          "supports_fast_delivery": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
