{
  "components": {
    "schemas": {
      "CatalogContext": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "default": "1.0.0-draft.1",
            "title": "Contract Version",
            "type": "string"
          },
          "currency": {
            "const": "toman",
            "default": "toman",
            "title": "Currency",
            "type": "string"
          },
          "dataset": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DatasetInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "notices": {
            "items": {
              "type": "string"
            },
            "title": "Notices",
            "type": "array"
          }
        },
        "title": "CatalogContext",
        "type": "object"
      },
      "CatalogPage": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/CatalogContext"
          },
          "has_next": {
            "title": "Has Next",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OfferCandidate"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "has_next",
          "context"
        ],
        "title": "CatalogPage",
        "type": "object"
      },
      "DatasetInfo": {
        "additionalProperties": false,
        "properties": {
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counts",
            "type": "object"
          },
          "coverage": {
            "const": "Tehran dataset; coverage is incomplete",
            "default": "Tehran dataset; coverage is incomplete",
            "title": "Coverage",
            "type": "string"
          },
          "dataset_id": {
            "title": "Dataset Id",
            "type": "string"
          },
          "imported_at": {
            "format": "date-time",
            "title": "Imported At",
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "sample",
              "provided"
            ],
            "title": "Source Kind",
            "type": "string"
          },
          "source_sha256": {
            "title": "Source Sha256",
            "type": "string"
          }
        },
        "required": [
          "dataset_id",
          "source_kind",
          "imported_at",
          "source_sha256",
          "counts"
        ],
        "title": "DatasetInfo",
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "JsonValue": {},
      "OfferCandidate": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "const": "unconfirmed",
            "default": "unconfirmed",
            "title": "Availability",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Km"
          },
          "evidence": {
            "const": "offer_record",
            "default": "offer_record",
            "title": "Evidence",
            "type": "string"
          },
          "last_price_changed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Price Changed At"
          },
          "offer_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Offer Id",
            "type": "string"
          },
          "price_toman": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 9000000000000.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Toman"
          },
          "product": {
            "$ref": "#/components/schemas/ProductSummary"
          },
          "requires_verification_before_visit": {
            "const": true,
            "default": true,
            "title": "Requires Verification Before Visit",
            "type": "boolean"
          },
          "seller_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seller Title"
          },
          "shop": {
            "$ref": "#/components/schemas/Shop"
          },
          "warranty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warranty"
          }
        },
        "required": [
          "offer_id",
          "product",
          "shop",
          "price_toman",
          "last_price_changed_at",
          "seller_title",
          "description",
          "warranty",
          "distance_km"
        ],
        "title": "OfferCandidate",
        "type": "object"
      },
      "OfferDetail": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/CatalogContext"
          },
          "item": {
            "$ref": "#/components/schemas/OfferCandidate"
          }
        },
        "required": [
          "item",
          "context"
        ],
        "title": "OfferDetail",
        "type": "object"
      },
      "Product": {
        "additionalProperties": false,
        "properties": {
          "brand_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand Name"
          },
          "category_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Name"
          },
          "image_urls": {
            "items": {
              "type": "string"
            },
            "title": "Image Urls",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "persian_title": {
            "minLength": 1,
            "title": "Persian Title",
            "type": "string"
          },
          "product_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Product Id",
            "type": "string"
          },
          "specs": {
            "items": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "title": "Specs",
            "type": "array"
          }
        },
        "required": [
          "product_id",
          "persian_title"
        ],
        "title": "Product",
        "type": "object"
      },
      "ProductDetail": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/CatalogContext"
          },
          "item": {
            "$ref": "#/components/schemas/Product"
          }
        },
        "required": [
          "item",
          "context"
        ],
        "title": "ProductDetail",
        "type": "object"
      },
      "ProductSummary": {
        "additionalProperties": false,
        "properties": {
          "brand_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand Name"
          },
          "category_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Name"
          },
          "image_urls": {
            "items": {
              "type": "string"
            },
            "title": "Image Urls",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "persian_title": {
            "minLength": 1,
            "title": "Persian Title",
            "type": "string"
          },
          "product_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Product Id",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "persian_title"
        ],
        "title": "ProductSummary",
        "type": "object"
      },
      "Shop": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "category_names": {
            "items": {
              "type": "string"
            },
            "title": "Category Names",
            "type": "array"
          },
          "contacts": {
            "items": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "title": "Contacts",
            "type": "array"
          },
          "contacts_status": {
            "const": "synthetic",
            "default": "synthetic",
            "title": "Contacts Status",
            "type": "string"
          },
          "identity_status": {
            "const": "synthetic_or_unverified",
            "default": "synthetic_or_unverified",
            "title": "Identity Status",
            "type": "string"
          },
          "instagram": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instagram"
          },
          "lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "location_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Label"
          },
          "lon": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
