# Reference only: this module DOES NOT load .env files.
# Supply the actual API key only through the server's environment/secret manager.
STORE_SCOUT_LLM_API_KEY=REPLACE_WITH_LOCAL_KEY
STORE_SCOUT_LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
# Non-secret setup reported as successful by the account owner for the Stage 1 smoke.
STORE_SCOUT_LLM_MODEL=gpt-6.1-sol
STORE_SCOUT_LLM_OUTPUT_LIMIT_PARAMETER=max_completion_tokens
# Extraction cap, distinct from the 64-token smoke cap; bounded to 512..2048.
# Verify this cap against your selected model. No extraction live call was made here.
STORE_SCOUT_LLM_EXTRACTION_MAX_TOKENS=1024
